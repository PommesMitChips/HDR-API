<Project>
  <Import Project="../../Directory.Build.props" />
  <PropertyGroup>
    <RepositoryRoot Condition="'$(RepositoryRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</RepositoryRoot>
    <JavaScriptSourceRoot Condition="'$(JavaScriptSourceRoot)' == ''">$(RepositoryRoot)/OptionalMods/HDRJavaScriptRuntime/Data/Scripts</JavaScriptSourceRoot>
    <JavaScriptChecksOutputRoot Condition="'$(JavaScriptChecksOutputRoot)' == ''">$(RepositoryRoot)/artifacts/js-prototype/checks</JavaScriptChecksOutputRoot>
    <BaseOutputPath>$(JavaScriptChecksOutputRoot)/build/$(MSBuildProjectName)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(JavaScriptChecksOutputRoot)/build/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>6</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
</Project>
