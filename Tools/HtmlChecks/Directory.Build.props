<Project>
  <Import Project="../../Directory.Build.props" />
  <PropertyGroup>
    <RepositoryRoot Condition="'$(RepositoryRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</RepositoryRoot>
    <FrontendRoot Condition="'$(FrontendRoot)' == ''">$(RepositoryRoot)/OptionalMods/HDRHtmlFrontend</FrontendRoot>
    <HtmlChecksOutputRoot Condition="'$(HtmlChecksOutputRoot)' == ''">$(RepositoryRoot)/artifacts/html-prototype/checks</HtmlChecksOutputRoot>
    <BaseOutputPath>$(HtmlChecksOutputRoot)/build/$(MSBuildProjectName)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(HtmlChecksOutputRoot)/build/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>6</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
</Project>
