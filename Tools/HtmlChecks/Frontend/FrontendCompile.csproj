<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Library</OutputType></PropertyGroup>
  <Import Project="../GameReferences.props" />
  <ItemGroup>
    <Compile Include="$(FrontendRoot)/Data/Scripts/HdrHtml/*.cs" />
    <Compile Include="$(RepositoryRoot)/Api/Mods/HdrHtmlApi.cs" />
    <Compile Include="$(FrontendRoot)/Examples/HtmlConsumerExample.cs" />
    <Compile Include="$(GeneratedHtmlPbHelper)" Condition="'$(GeneratedHtmlPbHelper)' != ''" />
  </ItemGroup>
  <Target Name="RequireGeneratedHtmlPbHelper" BeforeTargets="CoreCompile" Condition="'$(GeneratedHtmlPbHelper)' == '' Or !Exists('$(GeneratedHtmlPbHelper)')">
    <Error Text="Run Tools/HtmlChecks/Check.ps1 to generate the canonical HTML PB helper import wrapper for the complete frontend compilation." />
  </Target>
</Project>
